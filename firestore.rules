rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(collectionId) {
      return get(/databases/$(database)/documents/collections/$(collectionId)/members/$(request.auth.uid));
    }

    function isMember(collectionId) {
      return isSignedIn() && exists(/databases/$(database)/documents/collections/$(collectionId)/members/$(request.auth.uid));
    }

    function memberRole(collectionId) {
      return memberDoc(collectionId).data.role;
    }

    function isOwner(collectionId) {
      return isMember(collectionId) && memberRole(collectionId) == 'owner';
    }

    function isOwnerOrEditor(collectionId) {
      return isMember(collectionId) && memberRole(collectionId) in ['owner', 'editor'];
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /collections/{collectionId} {
      // The pending-invites inbox needs to show a collection's name/emoji
      // for a user who has a pending invite but isn't a member yet -- so
      // read access also extends to a signed-in user with a matching
      // invites/{email} doc for this collection, mirroring the same
      // exists() check the members/{uid} invite-acceptance rule below uses.
      allow read: if isMember(collectionId) ||
        (isSignedIn() && exists(/databases/$(database)/documents/collections/$(collectionId)/invites/$(request.auth.token.email)));
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwnerOrEditor(collectionId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(collectionId);
    }

    match /collections/{collectionId}/members/{uid} {
      allow read: if isMember(collectionId);
      allow create: if (isOwner(collectionId)
          && request.resource.data.role in ['owner', 'editor', 'viewer']) ||
        (isSignedIn()
         && !isMember(collectionId)
         && request.auth.uid == uid
         && request.resource.data.role == 'owner'
         && get(/databases/$(database)/documents/collections/$(collectionId)).data.ownerId == request.auth.uid) ||
        (isSignedIn()
         && request.auth.uid == uid
         && exists(/databases/$(database)/documents/collections/$(collectionId)/invites/$(request.auth.token.email))
         && request.resource.data.role == get(/databases/$(database)/documents/collections/$(collectionId)/invites/$(request.auth.token.email)).data.role
         && request.resource.data.role in ['editor', 'viewer']);
      allow update: if isOwner(collectionId) && request.resource.data.role in ['owner', 'editor', 'viewer'];
      allow delete: if (isOwner(collectionId) && request.auth.uid != uid) ||
        (isSignedIn() && request.auth.uid == uid && memberRole(collectionId) != 'owner');
    }

    // The nested match above scopes reads/writes to one known collectionId
    // and does not authorize a collectionGroup('members') query (Home
    // screen's "my collections" lookup) -- Firestore only authorizes
    // collection-group queries via a top-level `{path=**}` match. This lets
    // a signed-in user list only their own membership docs across every
    // collection; each doc's parent collection is then read under the
    // isMember() rule above, using the membership this rule just proved.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /collections/{collectionId}/invites/{email} {
      allow read: if isOwnerOrEditor(collectionId) || (isSignedIn() && request.auth.token.email == email);
      allow create, update: if isOwnerOrEditor(collectionId) && request.resource.data.role in ['editor', 'viewer'];
      allow delete: if isOwnerOrEditor(collectionId) || (isSignedIn() && request.auth.token.email == email);
    }

    // The nested match above scopes reads/writes to one known collectionId
    // and does not authorize a collectionGroup('invites') query (pending-
    // invites inbox lookup) -- Firestore only authorizes collection-group
    // queries via a top-level `{path=**}` match. This lets a signed-in user
    // list only invite docs addressed to their own email across every
    // collection; each doc's parent collection can already be read/deleted
    // by that same user under the nested rule above, using the email match
    // this rule just proved.
    match /{path=**}/invites/{inviteId} {
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
    }

    match /items/{itemId} {
      allow read: if isMember(resource.data.collectionId);
      allow create: if isOwnerOrEditor(request.resource.data.collectionId);
      allow update: if isOwnerOrEditor(resource.data.collectionId)
        && request.resource.data.collectionId == resource.data.collectionId;
      allow delete: if isOwnerOrEditor(resource.data.collectionId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
